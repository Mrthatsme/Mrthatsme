{
  // Minutes Regained client portal. Separate Worker + database from the main site,
  // mounted only on /portal* and /api/portal/* so the existing site Worker is untouched.
  "name": "mr-portal",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "minutesregained.com/portal*", "zone_name": "minutesregained.com" },
    { "pattern": "minutesregained.com/api/portal/*", "zone_name": "minutesregained.com" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mr-portal",
      // Replace with the id printed by: npx wrangler d1 create mr-portal
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": { "enabled": true }
}
