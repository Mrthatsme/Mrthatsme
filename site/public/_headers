# Cloudflare Pages security headers.
# Applied automatically on deploy -- no dashboard configuration needed.
#
# CSP note: the page has NO inline script except one JSON-LD block, which is
# allowed by exact hash below. If you edit the JSON-LD in index.html the hash
# must be recomputed or structured data will be blocked (the page still works).
# connect-src lists 'self' (for our own /api/* Worker routes -- checkout,
# agreement, lead capture) plus the two legacy form providers in the deploy
# README. If you use a different provider, add its origin there or the form
# will be blocked. Checkout handoff to Stripe is a full-page redirect
# (window.location), not a fetch, so Stripe's domain does not need to be here.
# cloudflareinsights.com entries allow Cloudflare Web Analytics (auto-injected).

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-MtdpOy2LBm8dGislfWZ52mKedD8G+i/RZ/sw8EIz3t4=' https://static.cloudflareinsights.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formspree.io https://api.web3forms.com https://cloudflareinsights.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Robots-Tag: index, follow

/site.css
  Cache-Control: public, max-age=3600

/site.js
  Cache-Control: public, max-age=3600

/start.css
  Cache-Control: public, max-age=3600

/start.js
  Cache-Control: public, max-age=3600
